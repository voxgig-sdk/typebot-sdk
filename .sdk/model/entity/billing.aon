# Entity: billing

main: kit: entity: billing: {

  alias: field: {}

  fields: [
    {
      name: "amount"
      req: true
      type: "`$NUMBER`"
    }
    {
      name: "currency"
      req: true
      type: "`$STRING`"
    }
    {
      name: "date"
      req: true
      type: "`$ANY`"
    }
    {
      name: "id"
      req: true
      type: "`$STRING`"
    }
    {
      format: "date-time"
      name: "resetsAt"
      req: true
      type: "`$STRING`"
    }
    {
      name: "totalChatsUsed"
      req: true
      type: "`$NUMBER`"
    }
    {
      name: "url"
      req: true
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "billing"
  op: {
    list: {
      name: "list"
      points: [
        {
          args: {
            query: [
              {
                kind: "query"
                name: "workspace_id"
                orig: "workspace_id"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/v1/billing/invoices"
          segments: [
            {
              lit: "v1"
            }
            {
              lit: "billing"
            }
            {
              lit: "invoices"
            }
          ]
          select: {
            "$action": "invoice"
            exist: [
              "workspace_id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.invoices`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          args: {
            query: [
              {
                kind: "query"
                name: "workspace_id"
                orig: "workspace_id"
                reqd: true
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/v1/billing/usage"
          segments: [
            {
              lit: "v1"
            }
            {
              lit: "billing"
            }
            {
              lit: "usage"
            }
          ]
          select: {
            "$action": "usage"
            exist: [
              "workspace_id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
