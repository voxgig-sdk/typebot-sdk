# BasicWorkspaceFlow

main: kit: flow: BasicWorkspaceFlow:
{
  entity: "workspace",
  kind: "basic",
  name: "BasicWorkspaceFlow",
  step: [
    {
      input: {
        ref: "workspace_ref01"
      }

      op: "create"
    }

    {
      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "workspace_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "workspace_ref01",
        srcdatavar: "workspace_ref01_data",
        suffix: "_up0",
        textfield: "createdAt"
      }

      op: "update",
      spec: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-workspace_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "workspace_ref01",
        srcdatavar: "workspace_ref01_data",
        suffix: "_dt0"
      }

      match: {
        id: "workspace01"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-workspace_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "workspace_ref01",
        suffix: "_rm0"
      }

      match: {
        id: "workspace01"
      }

      op: "remove"
    }

    {
      input: {
        suffix: "_rt0"
      }

      op: "list",
      valid: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "workspace_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicWorkspaceFlow"
}