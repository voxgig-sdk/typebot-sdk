# BasicTypebotFlow

main: kit: flow: BasicTypebotFlow:
{
  entity: "typebot",
  kind: "basic",
  name: "BasicTypebotFlow",
  step: [
    {
      input: {
        ref: "typebot_ref01"
      }

      op: "create"
    }

    {
      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "typebot_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "typebot_ref01",
        srcdatavar: "typebot_ref01_data",
        suffix: "_up0",
        textfield: "accessRight"
      }

      op: "update",
      spec: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-typebot_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "typebot_ref01",
        srcdatavar: "typebot_ref01_data",
        suffix: "_dt0"
      }

      match: {
        id: "typebot01"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-typebot_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "typebot_ref01",
        suffix: "_rm0"
      }

      match: {
        id: "typebot01"
      }

      op: "remove"
    }

    {
      input: {
        suffix: "_rt0"
      }

      op: "list",
      valid: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "typebot_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicTypebotFlow"
}