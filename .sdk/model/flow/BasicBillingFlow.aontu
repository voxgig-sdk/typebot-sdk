# BasicBillingFlow

main: kit: flow: BasicBillingFlow:
{
  entity: "billing",
  kind: "basic",
  name: "BasicBillingFlow",
  step: [
    {
      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "billing_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "billing_ref01",
        srcdatavar: "billing_ref01_data",
        suffix: "_dt0"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-billing_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicBillingFlow"
}